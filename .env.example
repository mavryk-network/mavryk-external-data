# =====================================================================
# Server
# =====================================================================
SERVER_PORT=3010
# Second HTTP listener for intra-cluster traffic. RWA routes are open here
# (no MBIO JWT) and /metrics, /docs, /openapi.yaml are mounted only on this
# listener when set. Leave unset for the legacy single-port layout.
# SERVER_INTERNAL_PORT=3011
SERVER_HOST=0.0.0.0
# debug | release | test. Empty derives from host (localhost → debug, anything
# else → release). Effective release refuses AUTH_ENABLED=false and default DB
# passwords, so local dev on 0.0.0.0 must set debug explicitly.
SERVER_GIN_MODE=debug
# SERVER_READ_TIMEOUT=30s
# SERVER_WRITE_TIMEOUT=30s
# SERVER_READ_HEADER_TIMEOUT=10s
# SERVER_IDLE_TIMEOUT=120s
# Snapshot cache TTL (seconds); 0 disables.
# SERVER_LATEST_QUOTE_CACHE_TTL_SECONDS=5
# Hard cap on the ?limit= query param for list endpoints.
# SERVER_MAX_QUERY_LIMIT=10000
# Per-handler ctx timeout (e.g. 10s). 0 disables (Server.{Read,Write}Timeout still applies).
# SERVER_HANDLER_TIMEOUT=10s
# Optional /debug/pprof — served on the internal listener only (needs
# SERVER_INTERNAL_PORT).
# SERVER_PPROF_ENABLED=false
# Inbound rate limit (0 disables). /healthz and /readyz are exempt.
# SERVER_RATE_LIMIT_RPS=10
# SERVER_RATE_LIMIT_BURST=20
# SERVER_RATE_LIMIT_PER_IP=true
# Comma-separated LB/proxy CIDRs whose X-Forwarded-For is honored for per-IP
# limiting. Empty = trust no proxy.
# SERVER_TRUSTED_PROXIES=10.0.0.0/8

# =====================================================================
# Database (Postgres + TimescaleDB)
# =====================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=quotes
POSTGRES_SSL=disable
POSTGRES_LOGGING=false
# TIMESCALEDB_IMAGE=timescale/timescaledb:latest-pg16

# =====================================================================
# FT live job (CoinGecko)
# =====================================================================
JOB_INTERVAL_SECONDS=60
JOB_ENABLED=true

# =====================================================================
# Outbound API defaults (shared across third-party clients)
# =====================================================================
API_TIMEOUT_SECONDS=30
OUTBOUND_HTTP_RETRY_MAX_ATTEMPTS=3
OUTBOUND_HTTP_RETRY_INITIAL_MS=200
OUTBOUND_HTTP_RETRY_MAX_MS=5000
OUTBOUND_HTTP_CIRCUIT_BREAKER_DISABLED=false
OUTBOUND_HTTP_CIRCUIT_BREAKER_INTERVAL_SECONDS=60
OUTBOUND_HTTP_CIRCUIT_BREAKER_OPEN_SECONDS=30
OUTBOUND_HTTP_CIRCUIT_BREAKER_HALF_OPEN_MAX_REQUESTS=1
OUTBOUND_HTTP_CIRCUIT_BREAKER_TRIP_AFTER_FAILURES=5
# Max bytes accepted from any single outbound HTTP response (post-decompress).
# Default 16 MiB; a negative value explicitly disables the cap.
# OUTBOUND_MAX_RESPONSE_BYTES=16777216

# =====================================================================
# Logging
# =====================================================================
# LOG_LEVEL: trace | debug | info | warn | error (default info). An invalid
# value is rejected with a startup warn-log and falls back to info.
# LOG_LEVEL=info
# LOG_CALLER: annotate log lines with the caller file:line (default true).
# LOG_CALLER=true

# =====================================================================
# CoinGecko
# =====================================================================
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Tier guide: demo=0.5rps | Pro Analyst=8rps | Pro Lite=16rps | Pro=60rps.
# Float accepted (0.5 = one request every 2s). Set RPS=0 to disable the limiter.
COINGECKO_RATE_LIMIT_RPS=8
# COINGECKO_RATE_LIMIT_BURST=16   # 0/unset = auto (2× RPS)

# =====================================================================
# Equiteez (GraphQL/Hasura) — RWA indexer via the public worker
# =====================================================================
# The worker injects the Hasura admin-secret and authorizes deployed (in-cluster)
# callers by origin/domain — so leave the *_PASSWORD vars empty in the cluster.
# LOCAL/CI ONLY: localhost has no allowed origin, so set the PASSWORD to the
# indexer's Hasura secret and the client passes it to the worker as ?bypass=<secret>.
# EQUITEEZ_INDEXER_URL=https://basenet.api.equiteez.com/v1/graphql
# EQUITEEZ_INDEXER_PASSWORD=
# EQUITEEZ_RATE_LIMIT_RPS=0
# EQUITEEZ_RATE_LIMIT_BURST=0

# =====================================================================
# RWA collector (writes to rwa_quote_prices)
# =====================================================================
# RWA_ENABLED=false
# RWA_INTERVAL_SECONDS=10        # Matches Mavryk 10s block time
# How often the Equiteez allowlist is re-synced into rwa_pairs (discovery of
# newly listed assets). Default 3600.
# RWA_PAIR_SYNC_INTERVAL_SECONDS=3600

# =====================================================================
# Tickers job (CoinGecko /coins/{id}/tickers — per-exchange market data)
# Powers /v1/tickers/:token/latest and /v1/tickers/:token/distribution.
# Disabled by default — flip TICKERS_ENABLED=true after migrations 0012-0014
# are applied. Single-token in v1 (MVRK); to add more, change the type to
# []string in config.Tickers and re-introduce a concurrency cap.
# =====================================================================
# TICKERS_ENABLED=false
# TICKERS_TOKEN_SYMBOL=mvrk
# TICKERS_INTERVAL_SECONDS=300   # 5 min — CoinGecko refreshes tickers slowly
# TICKERS_HTTP_TIMEOUT=10s
# TICKERS_INCLUDE_EXCHANGE_LOGO=true   # CG Pro flag; cheap, useful in UI

# In-process snapshot cache TTLs. /distribution costs more to compute
# (GROUP BY across latest-per-pair) but is called less often, so its TTL
# is longer at the same hit-ratio.
# TICKERS_CACHE_LATEST_TTL_SECONDS=30
# TICKERS_CACHE_DISTRIBUTION_TTL_SECONDS=60

# Server-side stale fence used by /v1/tickers/:token/latest. Rows whose
# `ts` is older than this are hidden by default; ?include_stale=true opts
# in. /distribution always excludes stale rows server-side regardless.
# Tune to ~12 × TICKERS_INTERVAL_SECONDS so a couple of missed ticks
# don't drop exchanges from the table.
# SERVER_TICKER_STALE_AFTER=1h

# =====================================================================
# Equiteez backfill (historical orderbook_order events → rwa_quote_prices, last-only)
# Disabled by default; opt-in. Same kill-switch story as RWA_ENABLED — both
# must be true. See docs/adr/0014-rwa-backfill-via-orderbook-order.md.
# =====================================================================
# EQUITEEZ_BACKFILL_ENABLED=false
# EQUITEEZ_BACKFILL_TICK_SECONDS=30
# EQUITEEZ_BACKFILL_BATCH_SIZE=200
# Filter ended_at >= this (RFC3339 or YYYY-MM-DD); empty = full history.
# EQUITEEZ_BACKFILL_START_FROM=
# Random ± offset on the first tick to avoid synchronized hammering across replicas.
# EQUITEEZ_BACKFILL_JITTER_MS=1000
# Auto-disable a pair after N consecutive errors.
# EQUITEEZ_BACKFILL_MAX_ERRORS=5
# EQUITEEZ_BACKFILL_BACKOFF_INITIAL_MS=2000
# EQUITEEZ_BACKFILL_BACKOFF_MAX_MS=60000
# Hard 24h cap on computed backoff.
# EQUITEEZ_BACKFILL_MAX_BACKOFF_MS=86400000

# =====================================================================
# CoinGecko backfill (reverse fetch into token_prices)
# =====================================================================
BACKFILL_ENABLED=false
BACKFILL_START_FROM=2025-09-18T00:00:00Z
# Hard floor; once oldest_ts reaches this, the token is auto-disabled with reason=reached_floor.
# BACKFILL_MIN_START_FROM=2024-01-01T00:00:00Z
BACKFILL_TICK_SECONDS=5
# Random jitter on the very first tick (per replica) to avoid synchronized hammering.
BACKFILL_JITTER_MS=1000
BACKFILL_CHUNK_MINUTES=360
# Auto-disable after N consecutive errors.
BACKFILL_MAX_ERRORS=5
BACKFILL_BACKOFF_INITIAL_MS=2000
BACKFILL_BACKOFF_MAX_MS=60000
# Hard 24h cap on computed backoff so a stuck token doesn't stretch waits to weeks.
BACKFILL_MAX_BACKOFF_MS=86400000

# =====================================================================
# Per-token overrides
# =====================================================================
# Format: TOKEN_<NAME>__<FIELD>     (note the DOUBLE underscore)
#
# Names mirror the `tokens:` map in config.yaml (lowercase). Env wins over yaml.
# A token that doesn't exist in yaml gets Enabled=true by default, so a one-off
# TOKEN_FOO__INTERVAL_SECONDS=60 lands as a live-enabled token.
#
# Supported fields per token:
#   INTERVAL_SECONDS         live-poll interval (seconds)
#   ENABLED                  enable/disable live collection (true/false)
#   TIMEOUT_SECONDS          HTTP timeout for this token's client
#   MIN_TIME_RANGE_SECONDS   floor on (to - from) for a live tick
#   LIVE_LOOKBACK_SECONDS    live job window: now - lookback .. now
#   MAX_CHUNK_MINUTES        upper bound on chunk size
#   BACKFILL_ENABLED         per-token backfill opt-out (true/false)
#                            global BACKFILL_ENABLED=false still wins as kill-switch
#   BACKFILL_START_FROM      RFC3339 or YYYY-MM-DD; floor for the backfill cursor
#   BACKFILL_CHUNK_MINUTES   reverse-fetch window size in minutes

# --- MVRK ---
# TOKEN_MVRK__INTERVAL_SECONDS=60
# TOKEN_MVRK__ENABLED=true
# TOKEN_MVRK__BACKFILL_ENABLED=true
# TOKEN_MVRK__BACKFILL_START_FROM=2025-09-18T14:00:00Z
# TOKEN_MVRK__BACKFILL_CHUNK_MINUTES=360

# --- USDT ---
# TOKEN_USDT__INTERVAL_SECONDS=240
# TOKEN_USDT__ENABLED=true
# TOKEN_USDT__BACKFILL_ENABLED=false
# TOKEN_USDT__BACKFILL_START_FROM=
# TOKEN_USDT__BACKFILL_CHUNK_MINUTES=360

# =====================================================================
# Auth (MBIO JWT)
# =====================================================================
# Verifies RS256 Bearer tokens on the public listener's RWA routes
# (/v1/rwa/*, /v1/pairs/rwa). Internal listener traffic skips this entirely.
#
# AUTH_ENABLED=false disables the middleware (dev/CI only). When unset/true the
# service refuses to start without AUTH_MBIO_JWT_ISSUER + a JWKS host (or local PEM).
# AUTH_ENABLED=true
# JWKS host: JWKS is fetched from {base}/.well-known/jwks.json. Either of these
# must be set in production unless AUTH_JWT_LOCAL_VERIFY_PUBLIC_KEY is used.
# AUTH_MBIO_JWT_BASE_URL=
# AUTH_MBIO_API_GATEWAY_BASE_URL=
# Required when auth is enabled — exact `iss` claim the IdP mints. MBIO uses a
# plain string (e.g. "mbio-api-gateway"), not a URL.
# AUTH_MBIO_JWT_ISSUER=mbio-api-gateway
# Optional — pins `aud` if MBIO ever starts minting it. Leave empty otherwise;
# the middleware logs a startup warning so the disabled check stays visible.
# AUTH_MBIO_JWT_AUDIENCE=
# How long keyfunc holds the JWKS before refresh. Default 5m.
# AUTH_JWKS_CACHE_TTL=5m
# Local / e2e fast-path: standard base64 of an RSA public-key PEM. When set the
# middleware skips JWKS entirely and verifies signatures against this key.
# Generate with `openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem
#   -pubout -out public.pem && base64 -i public.pem`.
# AUTH_JWT_LOCAL_VERIFY_PUBLIC_KEY=
