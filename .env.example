# =====================================================================
# Server
# =====================================================================
SERVER_PORT=3010
SERVER_HOST=0.0.0.0
# debug | release | test (empty = derive from host)
# SERVER_GIN_MODE=release
# SERVER_READ_TIMEOUT=30s
# SERVER_WRITE_TIMEOUT=30s
# SERVER_READ_HEADER_TIMEOUT=10s
# SERVER_IDLE_TIMEOUT=120s
# Snapshot cache TTL (seconds); 0 disables.
# SERVER_LATEST_QUOTE_CACHE_TTL_SECONDS=5
# Hard cap on the ?limit= query param for list endpoints.
# SERVER_MAX_QUERY_LIMIT=10000
# Per-handler ctx timeout (e.g. 10s). 0 disables (Server.{Read,Write}Timeout still applies).
# SERVER_HANDLER_TIMEOUT=10s
# Optional /debug/pprof — bind to a private interface in production.
# SERVER_PPROF_ENABLED=false
# CORS: comma-separated explicit origins (overrides YAML). Wildcard * is rejected.
# SERVER_CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

# =====================================================================
# Database (Postgres + TimescaleDB)
# =====================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=quotes
POSTGRES_SSL=disable
POSTGRES_LOGGING=false
# TIMESCALEDB_IMAGE=timescale/timescaledb:latest-pg16

# =====================================================================
# FT live job (CoinGecko)
# =====================================================================
JOB_INTERVAL_SECONDS=60
JOB_ENABLED=true

# =====================================================================
# Outbound API defaults (shared across third-party clients)
# =====================================================================
API_TIMEOUT_SECONDS=30
OUTBOUND_HTTP_RETRY_MAX_ATTEMPTS=3
OUTBOUND_HTTP_RETRY_INITIAL_MS=200
OUTBOUND_HTTP_RETRY_MAX_MS=5000
OUTBOUND_HTTP_CIRCUIT_BREAKER_DISABLED=false
OUTBOUND_HTTP_CIRCUIT_BREAKER_INTERVAL_SECONDS=60
OUTBOUND_HTTP_CIRCUIT_BREAKER_OPEN_SECONDS=30
OUTBOUND_HTTP_CIRCUIT_BREAKER_HALF_OPEN_MAX_REQUESTS=1
OUTBOUND_HTTP_CIRCUIT_BREAKER_TRIP_AFTER_FAILURES=5

# =====================================================================
# CoinGecko
# =====================================================================
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Tier guide: demo=0.5rps | Pro Analyst=8rps | Pro Lite=16rps | Pro=60rps.
# Float accepted (0.5 = one request every 2s). Set RPS=0 to disable the limiter.
COINGECKO_RATE_LIMIT_RPS=8
# COINGECKO_RATE_LIMIT_BURST=16   # 0/unset = auto (2× RPS)

# =====================================================================
# Equiteez (GraphQL/Hasura) — RWA indexer
# =====================================================================
# EQUITEEZ_INDEXER_URL=https://graphql.equiteez.com/v1/graphql
# EQUITEEZ_INDEXER_PASSWORD=
# EQUITEEZ_TOKEN_INDEXER_URL=
# EQUITEEZ_TOKEN_INDEXER_PASSWORD=
# EQUITEEZ_RATE_LIMIT_RPS=0
# EQUITEEZ_RATE_LIMIT_BURST=0

# =====================================================================
# RWA collector (writes to rwa_quote_prices)
# =====================================================================
# RWA_ENABLED=false
# RWA_INTERVAL_SECONDS=60
# RWA_CONCURRENCY=4

# =====================================================================
# CoinGecko backfill (reverse fetch into token_prices)
# =====================================================================
BACKFILL_ENABLED=false
BACKFILL_START_FROM=2025-09-18T00:00:00Z
# Hard floor; once oldest_ts reaches this, the token is auto-disabled with reason=reached_floor.
# BACKFILL_MIN_START_FROM=2024-01-01T00:00:00Z
BACKFILL_TICK_SECONDS=5
# Random jitter on the very first tick (per replica) to avoid synchronized hammering.
BACKFILL_JITTER_MS=1000
BACKFILL_CHUNK_MINUTES=360
# Auto-disable after N consecutive errors.
BACKFILL_MAX_ERRORS=5
BACKFILL_BACKOFF_INITIAL_MS=2000
BACKFILL_BACKOFF_MAX_MS=60000
# Hard 24h cap on computed backoff so a stuck token doesn't stretch waits to weeks.
BACKFILL_MAX_BACKOFF_MS=86400000
