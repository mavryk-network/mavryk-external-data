# Server configuration
SERVER_PORT=3010
SERVER_HOST=0.0.0.0
# Optional: debug | release | test (empty = derive from host)
# SERVER_GIN_MODE=release
# SERVER_READ_TIMEOUT=30s
# SERVER_WRITE_TIMEOUT=30s
# SERVER_READ_HEADER_TIMEOUT=10s
# SERVER_IDLE_TIMEOUT=120s
# Latest-quote response cache (seconds). 0 disables. If unset, config default applies (5 after YAML default).
# SERVER_LATEST_QUOTE_CACHE_TTL_SECONDS=0
# CORS: comma-separated explicit origins (overrides YAML list). Wildcard * is rejected.
# SERVER_CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

# Database configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=quotes
POSTGRES_SSL=disable
POSTGRES_LOGGING=false

# Job configuration
JOB_INTERVAL_SECONDS=60
JOB_ENABLED=true

# API configuration (CoinGecko outbound: timeout, rate limit, retry, circuit breaker)
API_TIMEOUT_SECONDS=30
API_RATE_LIMIT_RPS=10
# API_RATE_LIMIT_BURST=20
OUTBOUND_HTTP_RETRY_MAX_ATTEMPTS=3
OUTBOUND_HTTP_RETRY_INITIAL_MS=200
OUTBOUND_HTTP_RETRY_MAX_MS=5000
OUTBOUND_HTTP_CIRCUIT_BREAKER_DISABLED=false
OUTBOUND_HTTP_CIRCUIT_BREAKER_INTERVAL_SECONDS=60
OUTBOUND_HTTP_CIRCUIT_BREAKER_OPEN_SECONDS=30
OUTBOUND_HTTP_CIRCUIT_BREAKER_HALF_OPEN_MAX_REQUESTS=1
OUTBOUND_HTTP_CIRCUIT_BREAKER_TRIP_AFTER_FAILURES=5

# CoinGecko API configuration
COINGECKO_API_KEY=api_key
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Backfill
BACKFILL_ENABLED=true
BACKFILL_START_FROM=2025-09-18T00:00:00Z # 2025-09-18 (or RFC3339 like 2025-09-18T00:00:00Z)
BACKFILL_SLEEP_MS=5000
BACKFILL_CHUNK_MINUTES=3600