# Server configuration
SERVER_PORT=3010
SERVER_HOST=0.0.0.0
# Optional: debug | release | test (empty = derive from host)
# SERVER_GIN_MODE=release
# SERVER_READ_TIMEOUT=30s
# SERVER_WRITE_TIMEOUT=30s
# SERVER_READ_HEADER_TIMEOUT=10s
# SERVER_IDLE_TIMEOUT=120s
# Latest-quote response cache (seconds). 0 disables. If unset, config default applies (5 after YAML default).
# SERVER_LATEST_QUOTE_CACHE_TTL_SECONDS=0
# CORS: comma-separated explicit origins (overrides YAML list). Wildcard * is rejected.
# SERVER_CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com

# Database configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=quotes
POSTGRES_SSL=disable
POSTGRES_LOGGING=false
# Docker Compose only: TimescaleDB image (default latest-pg16). Pin e.g. timescale/timescaledb:2.16.1-pg16
# TIMESCALEDB_IMAGE=timescale/timescaledb:latest-pg16

# Job configuration
JOB_INTERVAL_SECONDS=60
JOB_ENABLED=true

# API configuration (shared outbound defaults: timeout + retry + circuit breaker).
# Per-service rate limits live in each service's own section below.
API_TIMEOUT_SECONDS=30
OUTBOUND_HTTP_RETRY_MAX_ATTEMPTS=3
OUTBOUND_HTTP_RETRY_INITIAL_MS=200
OUTBOUND_HTTP_RETRY_MAX_MS=5000
OUTBOUND_HTTP_CIRCUIT_BREAKER_DISABLED=false
OUTBOUND_HTTP_CIRCUIT_BREAKER_INTERVAL_SECONDS=60
OUTBOUND_HTTP_CIRCUIT_BREAKER_OPEN_SECONDS=30
OUTBOUND_HTTP_CIRCUIT_BREAKER_HALF_OPEN_MAX_REQUESTS=1
OUTBOUND_HTTP_CIRCUIT_BREAKER_TRIP_AFTER_FAILURES=5

# CoinGecko API configuration
COINGECKO_API_KEY=api_key
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Shared outbound throttle for every CoinGecko client/backfill worker in-process.
# Tier guide: demo=0.5rps | Pro Analyst=8rps | Pro Lite=16rps | Pro=60rps.
# Float accepted (e.g. 0.5 = one request every 2s). Set RPS=0 to disable.
COINGECKO_RATE_LIMIT_RPS=8
# COINGECKO_RATE_LIMIT_BURST=16   # 0/unset = auto (2× RPS)

# Equiteez indexer (GraphQL/Hasura). Independent rate limit from CoinGecko.
# Hasura admin-secret endpoints normally have no per-IP quota → default 0.
# EQUITEEZ_INDEXER_URL=https://graphql.equiteez.com/v1/graphql
# EQUITEEZ_INDEXER_PASSWORD=
# EQUITEEZ_TOKEN_INDEXER_URL=
# EQUITEEZ_TOKEN_INDEXER_PASSWORD=
# EQUITEEZ_RATE_LIMIT_RPS=0
# EQUITEEZ_RATE_LIMIT_BURST=0

# Backfill
BACKFILL_ENABLED=true
BACKFILL_START_FROM=2025-09-18T00:00:00Z # 2025-09-18 (or RFC3339 like 2025-09-18T00:00:00Z)
BACKFILL_SLEEP_MS=5000
BACKFILL_CHUNK_MINUTES=3600