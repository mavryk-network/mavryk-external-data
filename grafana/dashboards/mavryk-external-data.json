{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "text",
      "id": 1,
      "title": "About",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**Mavryk External Data** — observability dashboard.\n\nFour metric families in this board:\n- **HTTP (inbound)** — `http_*` from gin middleware.\n- **Outbound HTTP** — `outbound_http_*` from the resilience stack (CoinGecko + Equiteez). `outbound_http_requests_total{component,outcome}` counts every attempt (incl. retries); subtract `outbound_http_retries_total` to get logical-request RPS.\n- **Background jobs** — `job_*` and `backfill_*` from live, backfill, RWA collectors.\n- **Database pool** — `db_pool_*` sampled every 15s by `metrics.StartDBPoolCollector`.\n\nSet **namespace** to your scrape label (default: `mavryk-external-data`)."
      }
    },

    { "type": "row", "id": 2, "title": "HTTP (inbound)", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 }, "panels": [] },

    {
      "type": "timeseries", "id": 3, "title": "HTTP RPS (total)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "refId": "A",
        "expr": "sum(rate(http_requests_total{namespace=\"$namespace\"}[$__rate_interval]))",
        "legendFormat": "rps" }]
    },
    {
      "type": "timeseries", "id": 4, "title": "HTTP RPS by path",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "refId": "A",
        "expr": "sum by (path) (rate(http_requests_total{namespace=\"$namespace\"}[$__rate_interval]))",
        "legendFormat": "{{path}}" }]
    },
    {
      "type": "timeseries", "id": 5, "title": "HTTP latency p50 / p95 by path",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (path, le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p50 {{path}}" },
        { "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (path, le) (rate(http_request_duration_seconds_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p95 {{path}}" }
      ]
    },
    {
      "type": "timeseries", "id": 6, "title": "HTTP responses by status class",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "refId": "A",
        "expr": "sum by (status_class) (rate(http_responses_total{namespace=\"$namespace\"}[$__rate_interval]))",
        "legendFormat": "{{status_class}}" }]
    },
    {
      "type": "timeseries", "id": 7, "title": "HTTP RPS by method+path",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "refId": "A",
        "expr": "sum by (method, path) (rate(http_requests_total{namespace=\"$namespace\"}[$__rate_interval]))",
        "legendFormat": "{{method}} {{path}}" }]
    },

    { "type": "row", "id": 10, "title": "Outbound HTTP (CoinGecko / Equiteez)",
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }, "panels": [] },

    {
      "type": "stat", "id": 11, "title": "Circuit breaker state per component",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "closed",    "color": "green"  } } },
            { "type": "value", "options": { "1": { "text": "OPEN",      "color": "red"    } } },
            { "type": "value", "options": { "2": { "text": "half-open", "color": "yellow" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 1.5 },
            { "color": "red",    "value": 0.5 }
          ] }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "background"
      },
      "targets": [{ "refId": "A",
        "expr": "outbound_http_circuit_breaker_state{namespace=\"$namespace\"}",
        "legendFormat": "{{component}}" }]
    },
    {
      "type": "timeseries", "id": 12, "title": "Outbound retries (rate by component)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "refId": "A",
        "expr": "sum by (component) (rate(outbound_http_retries_total{namespace=\"$namespace\"}[$__rate_interval]))",
        "legendFormat": "{{component}}" }]
    },
    {
      "type": "timeseries", "id": 13, "title": "CB transitions (rate)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 34 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "refId": "A",
        "expr": "sum by (component, from_state, to_state) (rate(outbound_http_circuit_breaker_transitions_total{namespace=\"$namespace\"}[$__rate_interval]))",
        "legendFormat": "{{component}} {{from_state}}→{{to_state}}" }]
    },
    {
      "type": "timeseries", "id": 14, "title": "Rate-limit wait p95 (s)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 34 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (component, le) (rate(outbound_http_rate_limit_wait_seconds_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
        "legendFormat": "{{component}}" }]
    },
    {
      "type": "timeseries", "id": 15, "title": "Outbound RPS by component",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 40 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "description": "Every attempt (including retries) counted once. Subtract outbound_http_retries_total to get logical-request RPS."
        }
      },
      "targets": [{ "refId": "A",
        "expr": "sum by (component) (rate(outbound_http_requests_total{namespace=\"$namespace\"}[$__rate_interval]))",
        "legendFormat": "{{component}}" }]
    },
    {
      "type": "timeseries", "id": 16, "title": "Outbound requests by outcome",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 40 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "description": "Outcome: 2xx healthy, 4xx caller bug / rate-limited, 5xx upstream, error = transport failure (no HTTP status)."
        }
      },
      "targets": [{ "refId": "A",
        "expr": "sum by (component, outcome) (rate(outbound_http_requests_total{namespace=\"$namespace\"}[$__rate_interval]))",
        "legendFormat": "{{component}} {{outcome}}" }]
    },
    {
      "type": "stat", "id": 17, "title": "Outbound requests last 1h (by component)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 46 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "description": "Total outbound attempts in the last hour. Useful for capacity planning against CoinGecko's quota."
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [{ "refId": "A",
        "expr": "sum by (component) (increase(outbound_http_requests_total{namespace=\"$namespace\"}[1h]))",
        "legendFormat": "{{component}}" }]
    },
    {
      "type": "timeseries", "id": 18, "title": "Outbound error ratio (% non-2xx + transport)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 46 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "description": "Share of attempts that returned 4xx/5xx or failed at the transport layer. Sustained > 5% is alertable."
        }
      },
      "targets": [{ "refId": "A",
        "expr": "sum by (component) (rate(outbound_http_requests_total{namespace=\"$namespace\",outcome!=\"2xx\"}[$__rate_interval])) / clamp_min(sum by (component) (rate(outbound_http_requests_total{namespace=\"$namespace\"}[$__rate_interval])), 1e-9)",
        "legendFormat": "{{component}}" }]
    },

    { "type": "row", "id": 20, "title": "Background jobs (live / backfill / RWA)",
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 52 }, "panels": [] },

    {
      "type": "timeseries", "id": 21, "title": "Job tick duration p95 by (job, entity)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 53 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (job, source, entity, le) (rate(job_tick_duration_seconds_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
        "legendFormat": "{{job}}/{{source}}/{{entity}}" }]
    },
    {
      "type": "timeseries", "id": 22, "title": "Job errors by reason (rate)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 61 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "refId": "A",
        "expr": "sum by (job, source, reason) (rate(job_errors_total{namespace=\"$namespace\"}[$__rate_interval]))",
        "legendFormat": "{{job}}/{{source}} {{reason}}" }]
    },
    {
      "type": "timeseries", "id": 23, "title": "Rows affected (rate)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 61 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "refId": "A",
        "expr": "sum by (job, source, entity) (rate(job_rows_affected_total{namespace=\"$namespace\"}[$__rate_interval]))",
        "legendFormat": "{{job}} {{entity}}" }]
    },

    { "type": "row", "id": 30, "title": "Backfill cursor",
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 69 }, "panels": [] },

    {
      "type": "timeseries", "id": 31, "title": "Oldest backfilled timestamp (cursor) per token",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 70 },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "description": "Decreases over time as the backfill walks history backward; flat = stalled or reached_floor."
        }
      },
      "targets": [{ "refId": "A",
        "expr": "backfill_oldest_ts_seconds{namespace=\"$namespace\"} * 1000",
        "legendFormat": "{{source}}/{{entity}}" }]
    },
    {
      "type": "timeseries", "id": 32, "title": "Auto-disabled events (rate)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 78 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "refId": "A",
        "expr": "sum by (entity, reason) (increase(backfill_auto_disabled_total{namespace=\"$namespace\"}[1h]))",
        "legendFormat": "{{entity}} ({{reason}})" }]
    },

    { "type": "row", "id": 40, "title": "Database connection pool",
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 84 }, "panels": [] },

    {
      "type": "timeseries", "id": 41, "title": "DB pool connections (open / in_use / idle)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 85 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "refId": "A", "expr": "db_pool_open_connections{namespace=\"$namespace\"}",   "legendFormat": "open" },
        { "refId": "B", "expr": "db_pool_in_use_connections{namespace=\"$namespace\"}", "legendFormat": "in_use" },
        { "refId": "C", "expr": "db_pool_idle_connections{namespace=\"$namespace\"}",   "legendFormat": "idle" }
      ]
    },
    {
      "type": "stat", "id": 42, "title": "Open connections (current)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 85 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 18 },
            { "color": "red",    "value": 23 }
          ] }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [{ "refId": "A",
        "expr": "db_pool_open_connections{namespace=\"$namespace\"}",
        "legendFormat": "open" }]
    },
    {
      "type": "timeseries", "id": 43, "title": "DB pool wait duration (cumulative seconds)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 93 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "description": "Total seconds spent waiting for a free pool slot. A growing slope means the pool is too small for the workload."
        }
      },
      "targets": [{ "refId": "A",
        "expr": "rate(db_pool_wait_duration_seconds{namespace=\"$namespace\"}[$__rate_interval])",
        "legendFormat": "wait/s" }]
    },

    { "type": "row", "id": 50, "title": "FX conversions (RWA `?in=`)",
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 99 }, "panels": [] },

    {
      "type": "timeseries", "id": 51, "title": "FX conversion p95 by (source_token, target)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 100 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "description": "p95 wall-time of one Convert() call (cache hit + miss combined)."
        }
      },
      "targets": [{ "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (source_token, target, le) (rate(fx_conversion_duration_seconds_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
        "legendFormat": "{{source_token}} → {{target}}" }]
    },
    {
      "type": "timeseries", "id": 52, "title": "FX conversion outcomes (rate by result)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 100 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "description": "Conversions per second labelled by result. `success`/`identity` are healthy; `no_rate`/`unregistered_source`/`query_error` indicate a problem."
        }
      },
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "targets": [{ "refId": "A",
        "expr": "sum by (result) (rate(fx_conversions_total{namespace=\"$namespace\"}[$__rate_interval]))",
        "legendFormat": "{{result}}" }]
    },
    {
      "type": "timeseries", "id": 53, "title": "FX stale-rate per target (alertable)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 108 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "description": "Conversions returned with `fx.stale=true` (FX older than `server.fx_max_staleness_seconds`). A growing rate means the CoinGecko live job is behind. Alert on `> 1%` of total."
        }
      },
      "targets": [{ "refId": "A",
        "expr": "sum by (target) (rate(fx_stale_responses_total{namespace=\"$namespace\"}[$__rate_interval]))",
        "legendFormat": "{{target}}" }]
    }
  ],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 40,
  "tags": ["mavryk", "external-data", "quotes", "prometheus"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "mavryk-external-data", "value": "mavryk-external-data" },
        "hide": 0,
        "label": "Kubernetes namespace",
        "name": "namespace",
        "options": [
          { "selected": true, "text": "mavryk-external-data", "value": "mavryk-external-data" }
        ],
        "query": "mavryk-external-data",
        "skipUrlSync": false,
        "type": "constant"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Mavryk External Data (Quotes)",
  "uid": "mavryk-external-data-quotes",
  "version": 3,
  "weekStart": ""
}
